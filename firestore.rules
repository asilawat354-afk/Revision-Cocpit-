rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - deny access to unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication and ownership validation helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User data is strictly isolated per authenticated UID
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }
  }
}
